{
  "schema_version": 1,
  "study_id": "metropt_temporal_tabular_v2",
  "horizon_hours": [6, 12, 24, 48],
  "feature_sets": ["current_window", "temporal_context"],
  "models": ["dummy", "logistic_regression", "random_forest", "xgboost"],
  "random_seed": 42,
  "event_folds": [
    {
      "name": "may_failure",
      "validation_start": "2020-05-22 23:30:00",
      "failure_start": "2020-05-29 23:30:00"
    },
    {
      "name": "june_failure",
      "validation_start": "2020-05-30 06:00:00",
      "failure_start": "2020-06-05 10:00:00"
    },
    {
      "name": "july_holdout",
      "validation_start": "2020-07-08 14:30:00",
      "failure_start": "2020-07-15 14:30:00"
    }
  ],
  "development_events": ["may_failure", "june_failure"],
  "final_event": "july_holdout",
  "thresholds": {
    "reference": 0.5,
    "candidate_start": 0.01,
    "candidate_stop": 0.99,
    "candidate_step": 0.01,
    "objective": "f2",
    "selection_data": "development_events_only"
  },
  "model_parameters": {
    "logistic_regression": {"C": 1.0, "max_iter": 2000},
    "random_forest": {
      "n_estimators": 300,
      "min_samples_leaf": 2,
      "max_features": "sqrt"
    },
    "xgboost": {
      "n_estimators": 300,
      "learning_rate": 0.05,
      "max_depth": 3,
      "min_child_weight": 3,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 1.0
    }
  }
}
